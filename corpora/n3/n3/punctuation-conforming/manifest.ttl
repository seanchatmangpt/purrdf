@prefix ex: <http://example.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix n3t: <http://example.org/n3/test#> .
<> a mf:Manifest ; mf:entries ( <http://example.org/n3/punctuation-conforming> ) .
<http://example.org/n3/punctuation-conforming> a n3t:Parse ; mf:name "punctuation-conforming" ; mf:action [ n3t:sourceDocument <case.n3> ] ; mf:result "punctuation-conforming" ; mf:status n3t:proposed ; rdfs:comment """The 'a' keyword, predicate-object lists (';') and object lists (',') expand to the plain RDF triples in the expected artifact.""" .
